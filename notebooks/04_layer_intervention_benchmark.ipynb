 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Notebook 04: Layer Intervention Depth Characterization Benchmark\n",
    "\n",
    "This notebook demonstrates how to programmatically execute the **Layer Intervention Benchmark** across multiple transformer layers using `src.benchmark.layer_benchmark_runner`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "import json
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from src.benchmark.layer_benchmark_runner import run_layer_benchmark\n",
    "from src.sae_utils import load_model_and_sae"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Run Layer Benchmark Sweep Across Layers `[2, 5, 8, 10]`"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "results = run_layer_benchmark(\n",
    "    prompt=\"The location of Massachusetts Institute of Technology is in\",\n",
    "    target=\"Cambridge\",\n",
    "    layers=[2, 5, 8, 10],\n",
    "    mute_strength=0.3,\n",
    "    boost_strength=0.5,\n",
    "    mute_batch_size=3,\n",
    "    boost_batch_size=3,\n",
    "    use_safety=True,\n",
    "    algorithm=\"hybrid\"\n",
    ")\n",
    "\n",
    "print(f\"Benchmark completed! Saved to: {results.get('saved_filepath')}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Benchmark Results Table"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df = pd.DataFrame(results[\"layers\"])\n",
    "df[\"probability_gain_pct\"] = df[\"probability_gain\"] * 100\n",
    "display(df[[\"layer\", \"clean_rank\", \"final_rank\", \"rank_improvement\", \"clean_probability\", \"final_probability\", \"probability_gain_pct\", \"runtime_ms\", \"success\"]])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Visualize Probability Gain vs Layer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(7, 4))\n",
    "plt.bar([f\"Layer {l}\" for l in df[\"layer\"]], df[\"probability_gain_pct\"], color=\"#4C72B0\")\n",
    "plt.title(\"Target Probability Gain (%) vs Layer Depth\")\n",
    "plt.ylabel(\"Probability Gain (%)\")\n",
    "plt.grid(True, linestyle=\"--\", alpha=0.6)\n",
    "plt.show()"
   ]
  }
 ],
